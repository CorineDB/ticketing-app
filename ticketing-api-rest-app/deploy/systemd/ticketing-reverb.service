[Unit]
Description=Laravel Reverb WebSocket Server - Ticketing API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/ticketing-app/ticketing-api-rest-app
ExecStart=/usr/bin/php artisan reverb:start --host=127.0.0.1 --port=8020
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ticketing-reverb

[Install]
WantedBy=multi-user.target
