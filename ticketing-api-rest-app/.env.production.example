# =====================================================================
# Template d'environnement de PRODUCTION — serveur EC2 (Ubuntu 24.04)
#
# Utilisation (sur le serveur, dans ticketing-api-rest-app/) :
#   cp .env.production.example .env
#   php artisan key:generate
#   ... remplacer les valeurs "changeme" / placeholders ...
#
# Ce fichier ne contient AUCUN secret réel et peut être commité.
# Le vrai .env reste uniquement sur le serveur (jamais commité).
# =====================================================================

# --- Application ---
APP_NAME="Plateforme de gestion des tickets"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.ticketing.corinebocoga.com
CLIENT_APP_URL=https://ticketing.corinebocoga.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Logs ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Base de données (PostgreSQL local sur le serveur) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ticketing_db
DB_USERNAME=ticketing
DB_PASSWORD=changeme

# --- Sessions / Queue / Cache (drivers "database", pas de Redis) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local

# --- CORS : origine exacte du frontend (lu par config/cors.php) ---
FRONTEND_URL=https://ticketing.corinebocoga.com

# --- Temps réel : Laravel Reverb (websockets) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=changeme
REVERB_APP_KEY=changeme
REVERB_APP_SECRET=changeme
REVERB_HOST=api.ticketing.corinebocoga.com
REVERB_PORT=443
REVERB_SCHEME=https

# --- Mail (SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.titan.email
MAIL_PORT=587
MAIL_USERNAME=changeme
MAIL_PASSWORD=changeme
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=changeme
MAIL_FROM_NAME="${APP_NAME}"

# --- SMS ---
SMS_PROVIDER=custom_api
SMS_PROVIDER_URL=https://api.e-mc.co/v3
SMS_PROVIDER_API_ACCOUNT_ID=changeme
SMS_PROVIDER_API_ACCOUNT_PASSWORD=changeme
SMS_PROVIDER_API_KEY=changeme
SMS_API_KEY=changeme
SMS_API_SECRET=changeme
SMS_FROM_NUMBER=changeme

# --- Alertes ---
SMS_ALERT_THRESHOLD=1000
ALERT_EMAIL=changeme
ALERT_SMS=changeme

# --- FedaPay (live) ---
FEDAPAY_PUBLIC_KEY=changeme
FEDAPAY_SECRET_KEY=changeme
FEDAPAY_WEBHOOK_SECRET=changeme
FEDAPAY_ENVIRONMENT=live
FEDAPAY_CURRENCY=XOF

# --- Chiffrement des tokens ---
TOKEN_ENCRYPTION_KEY=changeme
TOKEN_ENCRYPTION_METHOD=AES-256-CBC

# --- OTP ---
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=3

# --- Abonnements ---
SUBSCRIPTION_PRICE_PER_YEAR=50000
SUBSCRIPTION_CURRENCY=XOF

# --- Divers ---

# --- Non utilisés sur ce serveur (gardés pour compatibilité) ---
# MAIL not used above; AWS S3 optionnel (backups plus tard)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
