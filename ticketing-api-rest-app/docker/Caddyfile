# Reverse proxy + HTTPS automatique (Let's Encrypt) pour l'API.
# Le domaine doit pointer (A record) vers l'Elastic IP de l'EC2 et les ports
# 80/443 doivent être ouverts dans le Security Group.
#
# Routage :
#   /app/*  -> conteneur "broadcasting" (Laravel Reverb WebSocket)
#   reste   -> conteneur "web" (Nginx + PHP-FPM dans l'image)

api.ticketing.corinebocoga.com {
	encode gzip zstd
	log

	@reverb path /app/*
	handle @reverb {
		reverse_proxy broadcasting:8080
	}

	handle {
		reverse_proxy web:8080
	}
}
